rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
     * ============================================================
     * AarogyaVaani - SIH Demo Firestore Rules
     * ============================================================
     *
     * The application uses Firebase Anonymous Authentication.
     * Therefore request.auth != null means that the application
     * has successfully created an anonymous Firebase session.
     *
     * The SIH prototype uses a fixed demo hospital:
     * DCH-001
     *
     * These rules are intended for the SIH prototype/demo.
     * They are NOT a substitute for production healthcare
     * authorization, auditing, or regulatory compliance.
     */

    /*
     * ------------------------------------------------------------
     * Helper functions
     * ------------------------------------------------------------
     */

    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string
        && id.size() > 0
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isDemoHospital(hospitalId) {
      return hospitalId == 'DCH-001';
    }

    function isPatientDocument(data) {
      return data.id is string
        && data.id.size() > 0
        && data.id.size() <= 128
        && (!('name' in data) ||
            (data.name is string && data.name.size() <= 150))
        && (!('phone' in data) ||
            (data.phone is string && data.phone.size() <= 30))
        && (!('abhaId' in data) ||
            (data.abhaId is string && data.abhaId.size() <= 50));
    }

    function isHospitalRegistration(data) {
      return (!('patientId' in data) ||
              (data.patientId is string && data.patientId.size() <= 128))
        && (!('abhaId' in data) ||
              (data.abhaId is string && data.abhaId.size() <= 64))
        && (!('hospitalId' in data) ||
              isDemoHospital(data.hospitalId))
        && (!('hospital_id' in data) ||
              isDemoHospital(data.hospital_id))
        && (!('uhid' in data) ||
              (data.uhid is string && data.uhid.size() <= 64));
    }

    function isEncounter(data) {
      return data.id is string
        && data.id.size() > 0
        && data.id.size() <= 128
        && (!('hospitalId' in data) ||
            isDemoHospital(data.hospitalId))
        && (!('hospital_id' in data) ||
            isDemoHospital(data.hospital_id));
    }

    function isSession(data) {
      return (!('hospitalId' in data) ||
              isDemoHospital(data.hospitalId))
        && (!('hospital_id' in data) ||
              isDemoHospital(data.hospital_id));
    }


    /*
     * ------------------------------------------------------------
     * PATIENTS
     * ------------------------------------------------------------
     *
     * The current SIH application searches patients by ABHA ID
     * and phone number, so authenticated demo sessions need
     * read access to the collection.
     *
     * Writes are validated and require authentication.
     */

    match /patients/{patientId} {

      allow get, list: if isAuthenticated();

      allow create, update:
        if isAuthenticated()
        && isValidId(patientId)
        && isPatientDocument(request.resource.data);

      allow delete:
        if isAuthenticated();


      /*
       * ----------------------------------------------------------
       * Patient hospital registrations
       * ----------------------------------------------------------
       */

      match /hospital_registrations/{hospitalId} {

        allow get, list:
          if isAuthenticated()
          && isDemoHospital(hospitalId);

        allow create, update:
          if isAuthenticated()
          && isDemoHospital(hospitalId)
          && isHospitalRegistration(request.resource.data);

        allow delete:
          if isAuthenticated()
          && isDemoHospital(hospitalId);
      }


      /*
       * ----------------------------------------------------------
       * Patient visits
       * ----------------------------------------------------------
       */

      match /visits/{visitId} {

        allow get, list:
          if isAuthenticated();

        allow create, update:
          if isAuthenticated()
          && isValidId(visitId)
          && isEncounter(request.resource.data);

        allow delete:
          if isAuthenticated();
      }
    }


    /*
     * ------------------------------------------------------------
     * HOSPITAL REGISTRATIONS
     * ------------------------------------------------------------
     *
     * Stores hospital-specific UHID information.
     *
     * The application queries this collection directly to find
     * existing registrations by ABHA ID, patient ID and UHID.
     */

    match /hospital_registrations/{registrationId} {

      allow get, list:
        if isAuthenticated();

      allow create, update:
        if isAuthenticated()
        && isValidId(registrationId)
        && isHospitalRegistration(request.resource.data);

      allow delete:
        if isAuthenticated();
    }


    /*
     * ------------------------------------------------------------
     * ENCOUNTERS
     * ------------------------------------------------------------
     *
     * Encounters are explicitly associated with DCH-001 by
     * the application.
     */

    match /encounters/{encounterId} {

      allow get, list:
        if isAuthenticated();

      allow create, update:
        if isAuthenticated()
        && isValidId(encounterId)
        && isEncounter(request.resource.data);

      allow delete:
        if isAuthenticated();
    }


    /*
     * ------------------------------------------------------------
     * SESSIONS
     * ------------------------------------------------------------
     *
     * Active kiosk sessions for the SIH demonstration.
     */

    match /sessions/{sessionId} {

      allow get, list:
        if isAuthenticated();

      allow create, update:
        if isAuthenticated()
        && isValidId(sessionId)
        && isSession(request.resource.data);

      allow delete:
        if isAuthenticated();
    }


    /*
     * ------------------------------------------------------------
     * TEST CONNECTION
     * ------------------------------------------------------------
     *
     * firebase.ts calls:
     * test/connection
     *
     * Keep this available only to authenticated sessions.
     */

    match /test/{docId} {

      allow get, list:
        if isAuthenticated();

      allow create, update:
        if isAuthenticated()
        && isValidId(docId);

      allow delete:
        if isAuthenticated();
    }


    /*
     * ------------------------------------------------------------
     * DEFAULT DENY
     * ------------------------------------------------------------
     *
     * Any collection/document not explicitly covered above
     * is denied.
     */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}